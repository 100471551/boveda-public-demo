{
  "name": "boveda-alpha",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:public": "vite",
    "server": "node engine/server.mjs",
    "build": "node demo-v2/scripts/build.mjs",
    "build:demo": "node demo-v2/scripts/build.mjs",
    "test": "node --test demo-v2/tests/*.test.mjs",
    "test:deploy": "node --test demo-v2/tests/*.test.mjs",
    "demo:export": "node scripts/export-public-demo.mjs",
    "demo:validate": "node demo-v2/scripts/validate.mjs",
    "report:stored": "node scripts/generate-stored-report.mjs",
    "validate:corpus": "node scripts/validate-corpus.mjs",
    "validate:live": "node scripts/live-validate.mjs",
    "validate:analytical": "node scripts/validate-analytical.mjs",
    "build:v1": "vite build",
    "test:v1:deploy": "node --test tests/public-demo-deployment.test.mjs tests/router.test.mjs tests/v102-feedback.test.mjs tests/v110-workspace.test.mjs",
    "test:v1": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "5.1.0",
    "pdf-parse": "1.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.1"
  }
}
