{
  "name": "boveda-alpha",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:public": "vite",
    "server": "node engine/server.mjs",
    "build": "vite build",
    "build:demo": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:deploy": "node --test tests/public-demo-deployment.test.mjs tests/router.test.mjs tests/v102-feedback.test.mjs tests/v110-workspace.test.mjs",
    "demo:export": "node scripts/export-public-demo.mjs",
    "demo:validate": "node scripts/public-demo-privacy.mjs public/demo-data/v1.0.2",
    "report:stored": "node scripts/generate-stored-report.mjs",
    "validate:corpus": "node scripts/validate-corpus.mjs",
    "validate:live": "node scripts/live-validate.mjs",
    "validate:analytical": "node scripts/validate-analytical.mjs"
  },
  "dependencies": {
    "express": "5.1.0",
    "pdf-parse": "1.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.1"
  }
